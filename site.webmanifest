{
  "name": "Sauvenza — Crash-Proof Tab & Session Manager",
  "short_name": "Sauvenza",
  "description": "Local-first Chrome extension that auto-saves every window, tab and tab group and restores your session after a crash.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#f7f8fc",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
